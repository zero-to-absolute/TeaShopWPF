<local:SectionViewBase x:Class="TeaShopManager.Views.Sections.ReportsSectionView"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:local="clr-namespace:TeaShopManager.Views.Sections">
    <local:SectionViewBase.Style>
        <Style TargetType="{x:Type local:SectionViewBase}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentSectionKey}" Value="Reports">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </local:SectionViewBase.Style>

    <Border Style="{StaticResource CardBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Visibility="{Binding CanUseAccountantReports, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                           FontSize="24"
                           Text="Бухгалтерские отчёты" />
                <TextBlock Margin="0,18,0,0"
                           Style="{StaticResource BodyTextStyle}"
                           TextWrapping="Wrap"
                           Text="Сформируйте отчёт и при необходимости выгрузите CSV." />

                <Border Margin="0,24,0,0"
                        Padding="24"
                        CornerRadius="18"
                        Background="{StaticResource PanelBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,18,0">
                                <TextBlock FontWeight="SemiBold"
                                           Text="Тип отчёта" />
                                <ComboBox MinWidth="260"
                                          Margin="0,10,0,0"
                                          Padding="8"
                                          ItemsSource="{Binding AccountantReports}"
                                          SelectedItem="{Binding SelectedAccountantReport}"
                                          DisplayMemberPath="Title" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Margin="0,0,18,0">
                                <TextBlock FontWeight="SemiBold"
                                           Text="Период с" />
                                <DatePicker Margin="0,10,0,0"
                                            SelectedDate="{Binding AccountantReportStartDate}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Margin="0,0,18,0">
                                <TextBlock FontWeight="SemiBold"
                                           Text="Период по" />
                                <DatePicker Margin="0,10,0,0"
                                            SelectedDate="{Binding AccountantReportEndDate}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3"
                                        Margin="0,0,18,0"
                                        Visibility="{Binding ShowSellerReportFilter, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock FontWeight="SemiBold"
                                           Text="Продавец" />
                                <ComboBox MinWidth="220"
                                          Margin="0,10,0,0"
                                          Padding="8"
                                          ItemsSource="{Binding ReportSellerOptions}"
                                          SelectedItem="{Binding SelectedReportSeller}"
                                          DisplayMemberPath="Name" />
                            </StackPanel>

                            <StackPanel Grid.Column="4"
                                        Margin="0,0,18,0"
                                        Visibility="{Binding ShowCategoryReportFilter, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock FontWeight="SemiBold"
                                           Text="Категория" />
                                <ComboBox MinWidth="220"
                                          Margin="0,10,0,0"
                                          Padding="8"
                                          ItemsSource="{Binding ReportCategoryOptions}"
                                          SelectedItem="{Binding SelectedReportCategory}"
                                          DisplayMemberPath="Name" />
                            </StackPanel>

                            <StackPanel Grid.Column="5"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Bottom">
                                <Button Width="180"
                                        Margin="0,0,12,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="Сформировать отчёт"
                                        Click="GenerateAccountantReportButton_OnClick" />
                                <Button Width="160"
                                        Style="{StaticResource MiniActionButtonStyle}"
                                        Content="Выгрузить CSV"
                                        IsEnabled="{Binding HasAccountantReportData}"
                                        Click="ExportAccountantReportButton_OnClick" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Margin="0,18,0,0"
                                   Style="{StaticResource BodyTextStyle}"
                                   TextWrapping="Wrap"
                                   Text="{Binding SelectedAccountantReportDescription}" />

                        <ItemsControl Grid.Row="2"
                                      Margin="0,22,0,0"
                                      ItemsSource="{Binding AccountantReportMetricCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="220"
                                            Margin="0,0,16,16"
                                            Padding="18"
                                            CornerRadius="16"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrushSoft}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource BodyTextStyle}"
                                                       Text="{Binding Label}" />
                                            <TextBlock Margin="0,10,0,0"
                                                       FontSize="22"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Value}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Grid.Row="3"
                                Padding="20"
                                CornerRadius="16"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock FontSize="20"
                                           FontWeight="SemiBold"
                                           Text="{Binding AccountantReportPreviewTitle}" />

                                <Grid Grid.Row="1"
                                      Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Style="{StaticResource BodyTextStyle}"
                                               Text="{Binding AccountantReportFilterSummary}" />
                                    <TextBlock Grid.Column="1"
                                               Margin="18,0,0,0"
                                               Style="{StaticResource BodyTextStyle}"
                                               Text="{Binding AccountantReportGeneratedAt}" />
                                </Grid>

                                <TextBlock Grid.Row="2"
                                           Margin="0,12,0,0"
                                           Style="{StaticResource BodyTextStyle}"
                                           Text="{Binding AccountantReportStatusText}" />

                                <Grid Grid.Row="3"
                                      Margin="0,16,0,0">
                                    <DataGrid Style="{StaticResource ShellDataGridStyle}"
                                              ItemsSource="{Binding SalesBySellerReportRows}"
                                              Visibility="{Binding IsSalesBySellerReportSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Продавец" Binding="{Binding SellerName}" Width="*" />
                                            <DataGridTextColumn Header="Заказов" Binding="{Binding OrdersCount}" Width="120" />
                                            <DataGridTextColumn Header="Позиций" Binding="{Binding PositionsCount}" Width="120" />
                                            <DataGridTextColumn Header="Продано" Binding="{Binding Quantity}" Width="120" />
                                            <DataGridTextColumn Header="Выручка" Binding="{Binding Revenue}" Width="140" />
                                            <DataGridTextColumn Header="Средний чек" Binding="{Binding AverageCheck}" Width="140" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <DataGrid Style="{StaticResource ShellDataGridStyle}"
                                              ItemsSource="{Binding SalesByCategoryReportRows}"
                                              Visibility="{Binding IsSalesByCategoryReportSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="*" />
                                            <DataGridTextColumn Header="Заказов" Binding="{Binding OrdersCount}" Width="120" />
                                            <DataGridTextColumn Header="Товаров" Binding="{Binding ProductCount}" Width="120" />
                                            <DataGridTextColumn Header="Продано" Binding="{Binding Quantity}" Width="120" />
                                            <DataGridTextColumn Header="Выручка" Binding="{Binding Revenue}" Width="140" />
                                            <DataGridTextColumn Header="Средняя цена" Binding="{Binding AveragePrice}" Width="140" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <DataGrid Style="{StaticResource ShellDataGridStyle}"
                                              ItemsSource="{Binding CashReportRows}"
                                              Visibility="{Binding IsCashReportSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Дата" Binding="{Binding ReportDate}" Width="180" />
                                            <DataGridTextColumn Header="Заказов" Binding="{Binding OrdersCount}" Width="120" />
                                            <DataGridTextColumn Header="Позиций" Binding="{Binding PositionsCount}" Width="120" />
                                            <DataGridTextColumn Header="Продано" Binding="{Binding Quantity}" Width="120" />
                                            <DataGridTextColumn Header="Выручка" Binding="{Binding Revenue}" Width="140" />
                                            <DataGridTextColumn Header="Средний чек" Binding="{Binding AverageCheck}" Width="140" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Margin="0,32,0,0"
                        Visibility="{Binding CanViewManagementReports, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                           FontSize="24"
                           Text="Управленческая аналитика" />
                <TextBlock Margin="0,18,0,0"
                           Style="{StaticResource BodyTextStyle}"
                           TextWrapping="Wrap"
                           Text="Каждая карточка открывает отдельный отчёт." />

                <ItemsControl Margin="0,24,0,0"
                              ItemsSource="{Binding AdminReportCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="360"
                                    Height="220"
                                    Margin="0,0,20,20"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Tag="{Binding}"
                                    Click="OpenManagementReportButton_OnClick">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CardBorder"
                                                Padding="24"
                                                CornerRadius="22"
                                                Background="{StaticResource PanelBrush}"
                                                BorderBrush="{StaticResource BorderBrushSoft}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <StackPanel VerticalAlignment="Top">
                                                    <TextBlock FontSize="24"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding Title}" />
                                                    <TextBlock Margin="0,14,0,0"
                                                               Style="{StaticResource BodyTextStyle}"
                                                               FontSize="16"
                                                               MaxHeight="78"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding Description}" />
                                                </StackPanel>

                                                <Border Grid.Row="1"
                                                        Height="44"
                                                        Margin="0,18,0,0"
                                                        Padding="18,0"
                                                        Background="{StaticResource SurfaceBrush}"
                                                        CornerRadius="12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock VerticalAlignment="Center"
                                                                   FontSize="18"
                                                                   FontWeight="SemiBold"
                                                                   Text="Открыть отчёт" />
                                                        <TextBlock Grid.Column="1"
                                                                   VerticalAlignment="Center"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="18"
                                                                   Text="&#xE72A;" />
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Border>
</local:SectionViewBase>
