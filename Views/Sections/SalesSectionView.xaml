<local:SectionViewBase x:Class="TeaShopManager.Views.Sections.SalesSectionView"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:local="clr-namespace:TeaShopManager.Views.Sections">
    <local:SectionViewBase.Style>
        <Style TargetType="{x:Type local:SectionViewBase}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentSectionKey}" Value="Sales">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </local:SectionViewBase.Style>

    <Border Style="{StaticResource CardBorderStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,18,0"
                    Padding="18"
                    CornerRadius="16"
                    Background="{StaticResource PanelBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="{Binding CurrentOrderTitle}" />
                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource BodyTextStyle}"
                                   Text="{Binding CurrentOrderDate}" />
                    </Grid>

                    <DataGrid Grid.Row="1"
                              Margin="0,16,0,0"
                              Style="{StaticResource ShellDataGridStyle}"
                              ItemsSource="{Binding SaleLines}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*" />
                            <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="120" />
                            <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="120" />
                            <DataGridTextColumn Header="Всего" Binding="{Binding TotalAmount}" Width="120" />
                            <DataGridTemplateColumn Header="" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MiniDangerButtonStyle}"
                                                Content="Убрать"
                                                Tag="{Binding}"
                                                Click="RemoveSaleLineButton_OnClick" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="2"
                            Margin="0,16,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="+ Добавить позицию"
                            Click="AddSaleLineButton_OnClick" />

                    <Grid Grid.Row="3"
                          Margin="0,20,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="Итого:" />
                            <TextBlock Grid.Column="1"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Text="{Binding CurrentOrderTotal}" />
                        </Grid>

                        <Grid Grid.Row="1"
                              Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Margin="0,0,10,0"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Content="Отменить"
                                    Click="CancelSaleButton_OnClick" />
                            <Button Grid.Column="1"
                                    Margin="10,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Оплачен"
                                    Click="CompleteSaleButton_OnClick" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Padding="18"
                    CornerRadius="16"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Text="БЫСТРОЕ ДОБАВЛЕНИЕ" />

                    <ItemsControl Margin="0,16,0,0"
                                  ItemsSource="{Binding QuickSaleItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,0,12"
                                        Padding="14"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="Transparent"
                                        HorizontalContentAlignment="Stretch"
                                        Tag="{Binding}"
                                        Click="QuickSaleButton_OnClick">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="12">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding Title}" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   Text="{Binding Price}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</local:SectionViewBase>
