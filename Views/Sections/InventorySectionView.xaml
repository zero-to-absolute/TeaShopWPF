<local:SectionViewBase x:Class="TeaShopManager.Views.Sections.InventorySectionView"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:local="clr-namespace:TeaShopManager.Views.Sections">
    <local:SectionViewBase.Style>
        <Style TargetType="{x:Type local:SectionViewBase}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentSectionKey}" Value="Supplies">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentSectionKey}" Value="SupplyDetails">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentSectionKey}" Value="Losses">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </local:SectionViewBase.Style>

    <Grid>
        <Border>
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentSectionKey}" Value="Supplies">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button Width="190"
                        HorizontalAlignment="Right"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="Добавить поставку"
                        Click="AddSupplyButton_OnClick" />

                <DataGrid Grid.Row="1"
                          Margin="0,20,0,0"
                          Style="{StaticResource ShellDataGridStyle}"
                          ItemsSource="{Binding Supplies}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Код поставки" Binding="{Binding SupplyCode}" Width="130" />
                        <DataGridTextColumn Header="Дата создания" Binding="{Binding CreationDate}" Width="160" />
                        <DataGridTextColumn Header="Дата доставки" Binding="{Binding DeliveryDate}" Width="160" />
                        <DataGridTextColumn Header="Статус поставки" Binding="{Binding StatusName}" Width="170" />
                        <DataGridTextColumn Header="Поставщик" Binding="{Binding SupplierName}" Width="*" />
                        <DataGridTextColumn Header="Пользователь" Binding="{Binding UserName}" Width="150" />
                        <DataGridTemplateColumn Header="Действия" Width="330">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Margin="0,0,8,0"
                                                Style="{StaticResource MiniActionButtonStyle}"
                                                Content="Изменить"
                                                IsEnabled="{Binding CanModify}"
                                                Tag="{Binding}"
                                                Click="EditSupplyButton_OnClick" />
                                        <Button Margin="0,0,8,0"
                                                Style="{StaticResource MiniActionButtonStyle}"
                                                Content="{Binding ReceiveActionText}"
                                                IsEnabled="{Binding CanReceive}"
                                                Tag="{Binding}"
                                                Click="ReceiveSupplyButton_OnClick" />
                                        <Button Style="{StaticResource MiniDangerButtonStyle}"
                                                Content="Удалить"
                                                IsEnabled="{Binding CanModify}"
                                                Tag="{Binding}"
                                                Click="DeleteSupplyButton_OnClick" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border>
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentSectionKey}" Value="SupplyDetails">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button Width="210"
                        HorizontalAlignment="Right"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="Добавить позицию"
                        Click="AddSupplyDetailButton_OnClick" />

                <DataGrid Grid.Row="1"
                          Margin="0,20,0,0"
                          Style="{StaticResource ShellDataGridStyle}"
                          ItemsSource="{Binding SupplyDetails}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Код поставки" Binding="{Binding SupplyCode}" Width="130" />
                        <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*" />
                        <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="130" />
                        <DataGridTextColumn Header="Цена за единицу" Binding="{Binding UnitPrice}" Width="150" />
                        <DataGridTextColumn Header="Дата производства" Binding="{Binding ProductionDate}" Width="170" />
                        <DataGridTemplateColumn Header="Действия" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Margin="0,0,8,0"
                                                Style="{StaticResource MiniActionButtonStyle}"
                                                Content="Изменить"
                                                IsEnabled="{Binding CanModify}"
                                                Tag="{Binding}"
                                                Click="EditSupplyDetailButton_OnClick" />
                                        <Button Style="{StaticResource MiniDangerButtonStyle}"
                                                Content="Удалить"
                                                IsEnabled="{Binding CanModify}"
                                                Tag="{Binding}"
                                                Click="DeleteSupplyDetailButton_OnClick" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border>
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentSectionKey}" Value="Losses">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button Width="190"
                        HorizontalAlignment="Right"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="Добавить списание"
                        Click="AddLossButton_OnClick" />

                <DataGrid Grid.Row="1"
                          Margin="0,20,0,0"
                          Style="{StaticResource ShellDataGridStyle}"
                          ItemsSource="{Binding Losses}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Код списания" Binding="{Binding LossCode}" Width="150" />
                        <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*" />
                        <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="140" />
                        <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="260" />
                        <DataGridTextColumn Header="Дата списания" Binding="{Binding LossDate}" Width="160" />
                        <DataGridTemplateColumn Header="Действия" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Margin="0,0,8,0"
                                                Style="{StaticResource MiniActionButtonStyle}"
                                                Content="Изменить"
                                                Tag="{Binding}"
                                                Click="EditLossButton_OnClick" />
                                        <Button Style="{StaticResource MiniDangerButtonStyle}"
                                                Content="Удалить"
                                                Tag="{Binding}"
                                                Click="DeleteLossButton_OnClick" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</local:SectionViewBase>
