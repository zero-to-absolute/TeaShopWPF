<Window x:Class="TeaShopManager.Views.ManagementReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="1320"
        Height="880"
        MinWidth="1100"
        MinHeight="760"
        WindowStartupLocation="CenterOwner">
    <Border Margin="18"
            Style="{StaticResource CardBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                           FontSize="26"
                           Text="{Binding WindowTitle}" />
                <TextBlock Margin="0,10,0,0"
                           Style="{StaticResource BodyTextStyle}"
                           TextWrapping="Wrap"
                           Text="{Binding WindowDescription}" />
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,22,0,0"
                    Padding="18"
                    CornerRadius="14"
                    Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Style="{StaticResource BodyTextStyle}"
                                   FontSize="12"
                                   Text="Дата с" />
                        <DatePicker Margin="0,8,0,0"
                                    SelectedDate="{Binding ReportStartDate}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="0,0,14,0">
                        <TextBlock Style="{StaticResource BodyTextStyle}"
                                   FontSize="12"
                                   Text="Дата по" />
                        <DatePicker Margin="0,8,0,0"
                                    SelectedDate="{Binding ReportEndDate}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Margin="0,0,14,0"
                                Visibility="{Binding ShowCategoryFilter, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource BodyTextStyle}"
                                   FontSize="12"
                                   Text="Категория" />
                        <ComboBox Margin="0,8,0,0"
                                  Height="40"
                                  Padding="12,4"
                                  DisplayMemberPath="Name"
                                  ItemsSource="{Binding CategoryOptions}"
                                  SelectedItem="{Binding SelectedCategory}" />
                    </StackPanel>

                    <Button Grid.Column="3"
                            Margin="0,20,12,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="Сформировать"
                            Click="GenerateButton_OnClick" />

                    <Button Grid.Column="4"
                            Margin="0,20,12,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="Выгрузить CSV"
                            IsEnabled="{Binding HasReportData}"
                            Click="ExportButton_OnClick" />

                    <Button Grid.Column="5"
                            Margin="0,20,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="Закрыть"
                            Click="CloseButton_OnClick" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="2"
                        Margin="0,18,0,0">
                <ItemsControl ItemsSource="{Binding MetricCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="210"
                                    Margin="0,0,14,14"
                                    Padding="16"
                                    CornerRadius="14"
                                    Background="{StaticResource PanelBrush}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BodyTextStyle}"
                                               FontSize="12"
                                               Text="{Binding Label}" />
                                    <TextBlock Margin="0,10,0,0"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Text="{Binding Value}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource BodyTextStyle}"
                           TextWrapping="Wrap"
                           Text="{Binding FilterSummary}" />
                <TextBlock Margin="0,6,0,0"
                           Style="{StaticResource BodyTextStyle}"
                           Text="{Binding GeneratedAtText}" />
                <TextBlock Margin="0,6,0,0"
                           Style="{StaticResource BodyTextStyle}"
                           Text="{Binding StatusText}" />
            </StackPanel>

            <ScrollViewer Grid.Row="3"
                          Margin="0,18,0,0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Visibility="{Binding IsSalesReport, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock FontSize="19"
                                   FontWeight="SemiBold"
                                   Text="Динамика продаж по дням" />
                        <DataGrid Margin="0,14,0,0"
                                  Style="{StaticResource ShellDataGridStyle}"
                                  ItemsSource="{Binding SalesDailyRows}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата" Binding="{Binding ReportDate}" Width="150" />
                                <DataGridTextColumn Header="Заказов" Binding="{Binding OrdersCount}" Width="130" />
                                <DataGridTextColumn Header="Позиций" Binding="{Binding PositionsCount}" Width="130" />
                                <DataGridTextColumn Header="Продано" Binding="{Binding Quantity}" Width="130" />
                                <DataGridTextColumn Header="Выручка" Binding="{Binding Revenue}" Width="160" />
                                <DataGridTextColumn Header="Средний чек" Binding="{Binding AverageCheck}" Width="160" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Margin="0,24,0,0"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Text="Лидеры по товарам" />
                        <DataGrid Margin="0,14,0,0"
                                  Style="{StaticResource ShellDataGridStyle}"
                                  ItemsSource="{Binding TopProductRows}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*" />
                                <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="200" />
                                <DataGridTextColumn Header="Заказов" Binding="{Binding OrdersCount}" Width="120" />
                                <DataGridTextColumn Header="Продано" Binding="{Binding Quantity}" Width="120" />
                                <DataGridTextColumn Header="Выручка" Binding="{Binding Revenue}" Width="160" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsProfitabilityReport, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock FontSize="19"
                                   FontWeight="SemiBold"
                                   Text="Маржинальность по товарам" />
                        <DataGrid Margin="0,14,0,0"
                                  Style="{StaticResource ShellDataGridStyle}"
                                  ItemsSource="{Binding ProfitabilityRows}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*" />
                                <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="180" />
                                <DataGridTextColumn Header="Продано" Binding="{Binding QuantitySold}" Width="110" />
                                <DataGridTextColumn Header="Выручка" Binding="{Binding Revenue}" Width="140" />
                                <DataGridTextColumn Header="Ср. себестоимость" Binding="{Binding AveragePurchaseCost}" Width="150" />
                                <DataGridTextColumn Header="Себестоимость" Binding="{Binding EstimatedCost}" Width="150" />
                                <DataGridTextColumn Header="Валовая прибыль" Binding="{Binding GrossProfit}" Width="150" />
                                <DataGridTextColumn Header="Маржа" Binding="{Binding MarginPercent}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsLossesReport, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock FontSize="19"
                                   FontWeight="SemiBold"
                                   Text="Списания" />
                        <DataGrid Margin="0,14,0,0"
                                  Style="{StaticResource ShellDataGridStyle}"
                                  ItemsSource="{Binding LossRows}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*" />
                                <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="180" />
                                <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="220" />
                                <DataGridTextColumn Header="Операций" Binding="{Binding OperationsCount}" Width="110" />
                                <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="120" />
                                <DataGridTextColumn Header="Потери по себестоимости" Binding="{Binding EstimatedCost}" Width="190" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Margin="0,24,0,0"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Text="Возвраты покупателей" />
                        <DataGrid Margin="0,14,0,0"
                                  Style="{StaticResource ShellDataGridStyle}"
                                  ItemsSource="{Binding CustomerReturnRows}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*" />
                                <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="180" />
                                <DataGridTextColumn Header="Возвратов" Binding="{Binding ReturnsCount}" Width="120" />
                                <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="120" />
                                <DataGridTextColumn Header="Сумма возвратов" Binding="{Binding Amount}" Width="160" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
