<Window x:Class="TeaShopManager.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TeaShopManager - Вход"
        Width="760"
        Height="680"
        MinWidth="680"
        MinHeight="580"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource AppBackgroundBrush}"
          Margin="30">
        <Border Width="560"
                Padding="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="30">
            <StackPanel>
                <TextBlock HorizontalAlignment="Center"
                           Style="{StaticResource SectionTitleTextStyle}"
                           Margin="0,2,0,0"
                           FontSize="34"
                           Text="Авторизация" />

                <Border Margin="0,34,0,0"
                        Height="76"
                        Background="#FBF5ED"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <Grid Margin="18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="20"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="&#xE77B;" />

                        <Grid Grid.Column="1">
                            <TextBox x:Name="LoginTextBox"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="18"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="2,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       IsHitTestVisible="False"
                                       Text="Логин">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=LoginTextBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <Border Margin="0,24,0,0"
                        Height="76"
                        Background="#FBF5ED"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <Grid Margin="18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="20"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="&#xE72E;" />

                        <Grid Grid.Column="1">
                            <PasswordBox x:Name="PasswordInput"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="18"
                                         Height="28"
                                         VerticalAlignment="Center"
                                         PasswordChanged="PasswordBox_OnPasswordChanged" />
                            <TextBlock x:Name="PasswordPlaceholder"
                                       Margin="2,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       IsHitTestVisible="False"
                                       Text="Пароль" />
                        </Grid>
                    </Grid>
                </Border>

                <TextBlock Margin="0,18,0,0"
                           Foreground="{StaticResource DangerTextBrush}"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Text="{Binding ErrorMessage}" />

                <Button Margin="0,32,0,0"
                        Height="62"
                        FontSize="18"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding LoginCommand}"
                        Content="Войти" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
