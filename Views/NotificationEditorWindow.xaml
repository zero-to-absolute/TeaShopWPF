<Window x:Class="TeaShopManager.Views.NotificationEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620"
        Height="620"
        MinWidth="560"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        SizeToContent="WidthAndHeight">
    <Border Margin="18"
            Style="{StaticResource CardBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                       FontSize="24"
                       Text="{Binding WindowTitle}" />

            <ScrollViewer Grid.Row="1" Margin="0,22,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Тип уведомления" />
                    <TextBox x:Name="TypeTextBox" Margin="0,10,0,0" Style="{StaticResource InputTextBoxStyle}" />

                    <TextBlock Margin="0,18,0,0" FontWeight="SemiBold" Text="Сообщение" />
                    <TextBox x:Name="MessageTextBox" Margin="0,10,0,0" MinHeight="100" Padding="14" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />

                    <TextBlock Margin="0,18,0,0" FontWeight="SemiBold" Text="Дата создания" />
                    <DatePicker x:Name="CreatedDatePicker" Margin="0,10,0,0" SelectedDateFormat="Short" />

                    <TextBlock Margin="0,18,0,0" FontWeight="SemiBold" Text="Товар" />
                    <ComboBox x:Name="ProductComboBox" Margin="0,10,0,0" Height="52" Padding="12,6" ItemsSource="{Binding ProductItems}" DisplayMemberPath="Name" SelectedValuePath="Id" />

                    <TextBlock Margin="0,18,0,0" FontWeight="SemiBold" Text="Пользователь" />
                    <ComboBox x:Name="UserComboBox" Margin="0,10,0,0" Height="52" Padding="12,6" ItemsSource="{Binding UserItems}" DisplayMemberPath="Name" SelectedValuePath="Id" />

                    <CheckBox x:Name="IsReadCheckBox" Margin="0,18,0,0" Content="Уведомление прочитано" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}" Content="Отмена" Click="CancelButton_OnClick" />
                <Button Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Content="Сохранить" Click="SaveButton_OnClick" />
            </Grid>
        </Grid>
    </Border>
</Window>
