<Window x:Class="TeaShopManager.Views.UserEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пользователь"
        Width="620"
        Height="640"
        MinWidth="580"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        SizeToContent="WidthAndHeight">
    <Border Margin="18"
            Style="{StaticResource CardBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                       FontSize="26"
                       Text="{Binding WindowTitle}" />

            <ScrollViewer Grid.Row="1"
                          Margin="0,22,0,0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Text="Логин" />
                    <TextBox x:Name="LoginTextBox"
                             Margin="0,10,0,0"
                             Style="{StaticResource InputTextBoxStyle}" />

                    <TextBlock Margin="0,18,0,0"
                               FontWeight="SemiBold"
                               Text="ФИО" />
                    <TextBox x:Name="FullNameTextBox"
                             Margin="0,10,0,0"
                             Style="{StaticResource InputTextBoxStyle}" />

                    <TextBlock Margin="0,18,0,0"
                               FontWeight="SemiBold"
                               Text="Роль" />
                    <ComboBox x:Name="RoleComboBox"
                              Margin="0,10,0,0"
                              Height="52"
                              Padding="12,6"
                              ItemsSource="{Binding RoleItems}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id" />

                    <TextBlock Margin="0,18,0,0"
                               FontWeight="SemiBold"
                               Text="Пароль" />
                    <PasswordBox x:Name="PasswordBox"
                                 Margin="0,10,0,0"
                                 Style="{StaticResource InputPasswordBoxStyle}" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2"
                  Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="Отмена"
                        Click="CancelButton_OnClick" />
                <Button Grid.Column="1"
                        Margin="10,0,0,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="Сохранить"
                        Click="SaveButton_OnClick" />
            </Grid>
        </Grid>
    </Border>
</Window>
