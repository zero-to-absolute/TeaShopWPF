<Window x:Class="TeaShopManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TeaShopManager"
        Width="1540"
        Height="940"
        MinWidth="1320"
        MinHeight="860"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16,18,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource BodyTextStyle}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="{Binding RoleTag}" />
                    <TextBlock Style="{StaticResource HeroHeadingTextStyle}"
                               Margin="0,16,0,0"
                               FontSize="30"
                               Text="TeaShopManager" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         Margin="0,28,0,22"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                </Grid.ColumnDefinitions>

                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{Binding IconGlyph}" />

                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="{Binding Title}" />

                                <Ellipse Grid.Column="2"
                                         Width="8"
                                         Height="8"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Fill="{StaticResource AttentionBrush}"
                                         Visibility="{Binding HasAttentionMark, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,0,12" />
                            <Setter Property="Padding" Value="18,18" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="12"
                                                BorderBrush="Transparent"
                                                BorderThickness="1">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#EFE4D7" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <Border Grid.Row="2"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyTextStyle}"
                                   FontSize="12"
                                   Text="Вы вошли как" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Width="52"
                                    Height="52"
                                    CornerRadius="26"
                                    Background="{StaticResource AccentBrush}">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="17"
                                           Text="{Binding CurrentUser.Initials}" />
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="14,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="{Binding CurrentUser.Login}" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource BodyTextStyle}"
                                           Text="{Binding CurrentUser.DisplayName}" />
                                <TextBlock Margin="0,2,0,0"
                                           Style="{StaticResource BodyTextStyle}"
                                           Text="{Binding RoleCaption}" />
                            </StackPanel>
                        </Grid>

                        <Button Margin="0,18,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding SignOutCommand}"
                                Content="Выйти" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1"
              Margin="20,18,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="24,12">
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource SectionTitleTextStyle}"
                           Text="{Binding PageTitle}" />
            </Border>

            <ScrollViewer Grid.Row="1"
                          Margin="0,18,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid MinHeight="720">
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentSectionKey}" Value="Users">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Button Width="170"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Добавить пользователя"
                                    Click="AddUserButton_OnClick" />
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  Margin="0,20,0,0"
                                  Style="{StaticResource ShellDataGridStyle}"
                                  ItemsSource="{Binding Users}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="150" />
                                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*" />
                                <DataGridTextColumn Header="Роль" Binding="{Binding RoleName}" Width="240" />
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120" />
                                <DataGridTemplateColumn Header="Действия" Width="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Margin="0,0,8,0"
                                                        Style="{StaticResource MiniActionButtonStyle}"
                                                        Content="Изменить"
                                                        Tag="{Binding}"
                                                        Click="EditUserButton_OnClick" />
                                                <Button Style="{StaticResource MiniDangerButtonStyle}"
                                                        Content="Удалить"
                                                        Tag="{Binding}"
                                                        Click="DeleteUserButton_OnClick" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentSectionKey}" Value="Roles">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Button Width="150"
                                HorizontalAlignment="Right"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="Добавить роль"
                                Click="AddRoleButton_OnClick" />

                        <DataGrid Grid.Row="1"
                                  Margin="0,20,0,0"
                                  Style="{StaticResource ShellDataGridStyle}"
                                  ItemsSource="{Binding Roles}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Код роли" Binding="{Binding RoleCode}" Width="160" />
                            <DataGridTextColumn Header="Название роли" Binding="{Binding RoleName}" Width="*" />
                            <DataGridTemplateColumn Header="Действия" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Margin="0,0,8,0"
                                                    Style="{StaticResource MiniActionButtonStyle}"
                                                    Content="Изменить"
                                                    Tag="{Binding}"
                                                    Click="EditRoleButton_OnClick" />
                                            <Button Style="{StaticResource MiniDangerButtonStyle}"
                                                    Content="Удалить"
                                                    Tag="{Binding}"
                                                    Click="DeleteRoleButton_OnClick" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    </Grid>
                </Border>

                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentSectionKey}" Value="Categories">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Button Width="170"
                                HorizontalAlignment="Right"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="Добавить категорию"
                                Click="AddCategoryButton_OnClick" />

                        <DataGrid Grid.Row="1"
                                  Margin="0,20,0,0"
                                  Style="{StaticResource ShellDataGridStyle}"
                                  ItemsSource="{Binding Categories}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Код категории" Binding="{Binding CategoryCode}" Width="180" />
                                <DataGridTextColumn Header="Название категории" Binding="{Binding CategoryName}" Width="*" />
                                <DataGridTemplateColumn Header="Действия" Width="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Margin="0,0,8,0"
                                                        Style="{StaticResource MiniActionButtonStyle}"
                                                        Content="Изменить"
                                                        Tag="{Binding}"
                                                        Click="EditCategoryButton_OnClick" />
                                                <Button Style="{StaticResource MiniDangerButtonStyle}"
                                                        Content="Удалить"
                                                        Tag="{Binding}"
                                                        Click="DeleteCategoryButton_OnClick" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentSectionKey}" Value="Products">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Padding="4"
                                    Background="{StaticResource PanelBrush}"
                                    CornerRadius="14">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource SelectedTabButtonStyle}"
                                            Content="Все товары" />
                                    <Button Margin="8,0,0,0"
                                            Style="{StaticResource TabButtonStyle}"
                                            Content="Проверка минимальных остатков" />
                                </StackPanel>
                            </Border>

                            <Button Grid.Column="1"
                                    Width="160"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Добавить товар"
                                    Click="AddProductButton_OnClick" />
                        </Grid>

                        <Border Grid.Row="1"
                                Margin="0,18,0,0"
                                Height="52"
                                Background="#FFFDFC"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="14">
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="&#xE721;" />

                                <Grid Grid.Column="1">
                                    <TextBox x:Name="ProductSearchTextBox"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="15"
                                             VerticalContentAlignment="Center"
                                             Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="2,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="15"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               IsHitTestVisible="False"
                                               Text="Поиск товаров...">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=ProductSearchTextBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="2"
                                  Margin="0,18,0,0"
                                  Style="{StaticResource ShellDataGridStyle}"
                                  ItemsSource="{Binding Products}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Название товара" Binding="{Binding ProductName}" Width="*" />
                                <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="120" />
                                <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="160" />
                                <DataGridTemplateColumn Header="Остаток" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding StockQuantity}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Мин. остаток" Binding="{Binding MinStockQuantity}" Width="140" />
                                <DataGridTextColumn Header="Срок годности" Binding="{Binding ExpirationDate}" Width="160" />
                                <DataGridTemplateColumn Header="Действия" Width="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Margin="0,0,8,0"
                                                        Style="{StaticResource MiniActionButtonStyle}"
                                                        Content="Изменить"
                                                        Tag="{Binding}"
                                                        Click="EditProductButton_OnClick" />
                                                <Button Style="{StaticResource MiniDangerButtonStyle}"
                                                        Content="Удалить"
                                                        Tag="{Binding}"
                                                        Click="DeleteProductButton_OnClick" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentSectionKey}" Value="StatusOrders">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Button Width="185"
                                HorizontalAlignment="Right"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="Добавить статус"
                                Click="AddStatusOrderButton_OnClick" />

                        <DataGrid Grid.Row="1"
                                  Margin="0,20,0,0"
                                  Style="{StaticResource ShellDataGridStyle}"
                                  ItemsSource="{Binding StatusOrders}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Код статуса" Binding="{Binding StatusCode}" Width="170" />
                            <DataGridTextColumn Header="Название статуса" Binding="{Binding StatusName}" Width="*" />
                            <DataGridTemplateColumn Header="Действия" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Margin="0,0,8,0"
                                                    Style="{StaticResource MiniActionButtonStyle}"
                                                    Content="Изменить"
                                                    Tag="{Binding}"
                                                    Click="EditStatusOrderButton_OnClick" />
                                            <Button Style="{StaticResource MiniDangerButtonStyle}"
                                                    Content="Удалить"
                                                    Tag="{Binding}"
                                                    Click="DeleteStatusOrderButton_OnClick" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    </Grid>
                </Border>

                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentSectionKey}" Value="StatusSupplies">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Button Width="185"
                                HorizontalAlignment="Right"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="Добавить статус"
                                Click="AddStatusSupplyButton_OnClick" />

                        <DataGrid Grid.Row="1"
                                  Margin="0,20,0,0"
                                  Style="{StaticResource ShellDataGridStyle}"
                                  ItemsSource="{Binding StatusSupplies}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Код статуса" Binding="{Binding StatusCode}" Width="170" />
                            <DataGridTextColumn Header="Название статуса" Binding="{Binding StatusName}" Width="*" />
                            <DataGridTemplateColumn Header="Действия" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Margin="0,0,8,0"
                                                    Style="{StaticResource MiniActionButtonStyle}"
                                                    Content="Изменить"
                                                    Tag="{Binding}"
                                                    Click="EditStatusSupplyButton_OnClick" />
                                            <Button Style="{StaticResource MiniDangerButtonStyle}"
                                                    Content="Удалить"
                                                    Tag="{Binding}"
                                                    Click="DeleteStatusSupplyButton_OnClick" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    </Grid>
                </Border>

                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentSectionKey}" Value="Suppliers">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Button Width="180"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Добавить поставщика"
                                    Click="AddSupplierButton_OnClick" />
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  Margin="0,20,0,0"
                                  Style="{StaticResource ShellDataGridStyle}"
                                  ItemsSource="{Binding Suppliers}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Название поставщика" Binding="{Binding SupplierName}" Width="220" />
                                <DataGridTextColumn Header="Контактное лицо" Binding="{Binding ContactPerson}" Width="180" />
                                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="160" />
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="220" />
                                <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="*" />
                                <DataGridTemplateColumn Header="Действия" Width="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Margin="0,0,8,0"
                                                        Style="{StaticResource MiniActionButtonStyle}"
                                                        Content="Изменить"
                                                        Tag="{Binding}"
                                                        Click="EditSupplierButton_OnClick" />
                                                <Button Style="{StaticResource MiniDangerButtonStyle}"
                                                        Content="Удалить"
                                                        Tag="{Binding}"
                                                        Click="DeleteSupplierButton_OnClick" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentSectionKey}" Value="OrderDetails">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Button Width="210"
                                HorizontalAlignment="Right"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="Добавить позицию"
                                Click="AddOrderDetailButton_OnClick" />

                        <DataGrid Grid.Row="1"
                                  Margin="0,20,0,0"
                                  Style="{StaticResource ShellDataGridStyle}"
                                  ItemsSource="{Binding OrderDetails}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Код заказа" Binding="{Binding OrderCode}" Width="150" />
                            <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*" />
                            <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="140" />
                            <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="140" />
                            <DataGridTemplateColumn Header="Действия" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Margin="0,0,8,0"
                                                    Style="{StaticResource MiniActionButtonStyle}"
                                                    Content="Изменить"
                                                    Tag="{Binding}"
                                                    Click="EditOrderDetailButton_OnClick" />
                                            <Button Style="{StaticResource MiniDangerButtonStyle}"
                                                    Content="Удалить"
                                                    Tag="{Binding}"
                                                    Click="DeleteOrderDetailButton_OnClick" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    </Grid>
                </Border>

                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentSectionKey}" Value="Orders">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Button Width="170"
                                HorizontalAlignment="Right"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="Добавить заказ"
                                Click="AddOrderButton_OnClick" />

                        <DataGrid Grid.Row="1"
                                  Margin="0,20,0,0"
                                  Style="{StaticResource ShellDataGridStyle}"
                                  ItemsSource="{Binding Orders}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Код заказа" Binding="{Binding OrderCode}" Width="150" />
                                <DataGridTextColumn Header="Дата заказа" Binding="{Binding OrderDate}" Width="200" />
                                <DataGridTextColumn Header="Статус заказа" Binding="{Binding StatusName}" Width="170" />
                                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount}" Width="140" />
                                <DataGridTemplateColumn Header="Действия" Width="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Margin="0,0,8,0"
                                                        Style="{StaticResource MiniActionButtonStyle}"
                                                        Content="Изменить"
                                                        Tag="{Binding}"
                                                        Click="EditOrderButton_OnClick" />
                                                <Button Style="{StaticResource MiniDangerButtonStyle}"
                                                        Content="Удалить"
                                                        Tag="{Binding}"
                                                        Click="DeleteOrderButton_OnClick" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentSectionKey}" Value="Notifications">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Button Width="220"
                                HorizontalAlignment="Right"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="Добавить уведомление"
                                Click="AddNotificationButton_OnClick" />

                        <DataGrid Grid.Row="1"
                                  Margin="0,20,0,0"
                                  Style="{StaticResource ShellDataGridStyle}"
                                  ItemsSource="{Binding Notifications}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Тип уведомления" Binding="{Binding NotificationType}" Width="170" />
                                <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="*" />
                                <DataGridTextColumn Header="Дата создания" Binding="{Binding CreatedAt}" Width="170" />
                                <DataGridTextColumn Header="Статус" Binding="{Binding ReadState}" Width="140" />
                                <DataGridTemplateColumn Header="Действия" Width="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Margin="0,0,8,0"
                                                        Style="{StaticResource MiniActionButtonStyle}"
                                                        Content="Изменить"
                                                        Tag="{Binding}"
                                                        Click="EditNotificationButton_OnClick" />
                                                <Button Style="{StaticResource MiniDangerButtonStyle}"
                                                        Content="Удалить"
                                                        Tag="{Binding}"
                                                        Click="DeleteNotificationButton_OnClick" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentSectionKey}" Value="Supplies">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Button Width="190"
                                HorizontalAlignment="Right"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="Добавить поставку"
                                Click="AddSupplyButton_OnClick" />

                        <DataGrid Grid.Row="1"
                                  Margin="0,20,0,0"
                                  Style="{StaticResource ShellDataGridStyle}"
                                  ItemsSource="{Binding Supplies}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Код поставки" Binding="{Binding SupplyCode}" Width="130" />
                            <DataGridTextColumn Header="Дата создания" Binding="{Binding CreationDate}" Width="160" />
                            <DataGridTextColumn Header="Дата доставки" Binding="{Binding DeliveryDate}" Width="160" />
                            <DataGridTextColumn Header="Статус поставки" Binding="{Binding StatusName}" Width="170" />
                            <DataGridTextColumn Header="Поставщик" Binding="{Binding SupplierName}" Width="*" />
                            <DataGridTextColumn Header="Пользователь" Binding="{Binding UserName}" Width="150" />
                            <DataGridTemplateColumn Header="Действия" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Margin="0,0,8,0"
                                                    Style="{StaticResource MiniActionButtonStyle}"
                                                    Content="Изменить"
                                                    Tag="{Binding}"
                                                    Click="EditSupplyButton_OnClick" />
                                            <Button Style="{StaticResource MiniDangerButtonStyle}"
                                                    Content="Удалить"
                                                    Tag="{Binding}"
                                                    Click="DeleteSupplyButton_OnClick" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    </Grid>
                </Border>

                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentSectionKey}" Value="SupplyDetails">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Button Width="210"
                                HorizontalAlignment="Right"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="Добавить позицию"
                                Click="AddSupplyDetailButton_OnClick" />

                        <DataGrid Grid.Row="1"
                                  Margin="0,20,0,0"
                                  Style="{StaticResource ShellDataGridStyle}"
                                  ItemsSource="{Binding SupplyDetails}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Код поставки" Binding="{Binding SupplyCode}" Width="130" />
                            <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*" />
                            <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="130" />
                            <DataGridTextColumn Header="Цена за единицу" Binding="{Binding UnitPrice}" Width="150" />
                            <DataGridTextColumn Header="Дата производства" Binding="{Binding ProductionDate}" Width="170" />
                            <DataGridTemplateColumn Header="Действия" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Margin="0,0,8,0"
                                                    Style="{StaticResource MiniActionButtonStyle}"
                                                    Content="Изменить"
                                                    Tag="{Binding}"
                                                    Click="EditSupplyDetailButton_OnClick" />
                                            <Button Style="{StaticResource MiniDangerButtonStyle}"
                                                    Content="Удалить"
                                                    Tag="{Binding}"
                                                    Click="DeleteSupplyDetailButton_OnClick" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    </Grid>
                </Border>

                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentSectionKey}" Value="Losses">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Button Width="190"
                                HorizontalAlignment="Right"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="Добавить списание"
                                Click="AddLossButton_OnClick" />

                        <DataGrid Grid.Row="1"
                                  Margin="0,20,0,0"
                                  Style="{StaticResource ShellDataGridStyle}"
                                  ItemsSource="{Binding Losses}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Код списания" Binding="{Binding LossCode}" Width="150" />
                            <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*" />
                            <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="260" />
                            <DataGridTextColumn Header="Дата списания" Binding="{Binding LossDate}" Width="160" />
                            <DataGridTemplateColumn Header="Действия" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Margin="0,0,8,0"
                                                    Style="{StaticResource MiniActionButtonStyle}"
                                                    Content="Изменить"
                                                    Tag="{Binding}"
                                                    Click="EditLossButton_OnClick" />
                                            <Button Style="{StaticResource MiniDangerButtonStyle}"
                                                    Content="Удалить"
                                                    Tag="{Binding}"
                                                    Click="DeleteLossButton_OnClick" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    </Grid>
                </Border>

                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentSectionKey}" Value="Reports">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Border Width="760"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Padding="24"
                                CornerRadius="18"
                                Background="{StaticResource PanelBrush}"
                                Visibility="{Binding IsAccountantRole, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock HorizontalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="26"
                                           Text="&#xE8A5;" />
                                <TextBlock Margin="0,16,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="28"
                                           FontWeight="SemiBold"
                                           Text="Бухгалтерия" />
                                <TextBlock Margin="0,10,0,24"
                                           HorizontalAlignment="Center"
                                           Style="{StaticResource BodyTextStyle}"
                                           Text="Выберите тип отчёта для выгрузки в CSV формат" />

                                <ItemsControl ItemsSource="{Binding AccountantReports}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,14"
                                                    Padding="16"
                                                    CornerRadius="12"
                                                    Background="{StaticResource SurfaceBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock VerticalAlignment="Center"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding Number}" />
                                                    <TextBlock Grid.Column="1"
                                                               VerticalAlignment="Center"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding Title}" />
                                                    <Button Grid.Column="2"
                                                            Width="130"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Content="{Binding ButtonText}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding AdminReportCards}"
                                      Visibility="{Binding IsAdminRole, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="320"
                                            Margin="0,0,18,18"
                                            Padding="18"
                                            CornerRadius="16"
                                            Background="{StaticResource PanelBrush}">
                                        <StackPanel>
                                            <Border Width="34"
                                                    Height="34"
                                                    Background="{Binding AccentColor}"
                                                    CornerRadius="6" />
                                            <TextBlock Margin="0,16,0,0"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Title}" />
                                            <TextBlock Margin="0,10,0,16"
                                                       Style="{StaticResource BodyTextStyle}"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding Description}" />
                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="Открыть" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentSectionKey}" Value="Sales">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Margin="0,0,18,0"
                                Padding="18"
                                CornerRadius="16"
                                Background="{StaticResource PanelBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock FontSize="20"
                                               FontWeight="SemiBold"
                                               Text="{Binding CurrentOrderTitle}" />
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource BodyTextStyle}"
                                               Text="{Binding CurrentOrderDate}" />
                                </Grid>

                                <DataGrid Grid.Row="1"
                                          Margin="0,16,0,0"
                                          Style="{StaticResource ShellDataGridStyle}"
                                          ItemsSource="{Binding SaleLines}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*" />
                                        <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="120" />
                                        <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="120" />
                                        <DataGridTextColumn Header="Всего" Binding="{Binding TotalAmount}" Width="120" />
                                        <DataGridTemplateColumn Header="" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource MiniDangerButtonStyle}"
                                                            Content="Убрать"
                                                            Tag="{Binding}"
                                                            Click="RemoveSaleLineButton_OnClick" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Button Grid.Row="2"
                                        Margin="0,16,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="+ Добавить позицию"
                                        Click="AddSaleLineButton_OnClick" />

                                <Grid Grid.Row="3"
                                      Margin="0,20,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Text="Итого:" />
                                        <TextBlock Grid.Column="1"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Text="{Binding CurrentOrderTotal}" />
                                    </Grid>

                                    <Grid Grid.Row="1"
                                          Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Button Margin="0,0,10,0"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Content="Отменить"
                                                Click="CancelSaleButton_OnClick" />
                                        <Button Grid.Column="1"
                                                Margin="10,0,0,0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Content="Оплачен"
                                                Click="CompleteSaleButton_OnClick" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1"
                                Padding="18"
                                CornerRadius="16"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Text="БЫСТРОЕ ДОБАВЛЕНИЕ" />

                                <ItemsControl Margin="0,16,0,0"
                                              ItemsSource="{Binding QuickSaleItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,0,12"
                                                    Padding="14"
                                                    Background="{StaticResource PanelBrush}"
                                                    BorderBrush="Transparent"
                                                    HorizontalContentAlignment="Stretch"
                                                    Tag="{Binding}"
                                                    Click="QuickSaleButton_OnClick">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="12">
                                                            <ContentPresenter />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold"
                                                               Text="{Binding Title}" />
                                                    <TextBlock Margin="0,6,0,0"
                                                               Style="{StaticResource BodyTextStyle}"
                                                               Text="{Binding Price}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentSectionKey}" Value="Settings">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                   FontSize="24"
                                   Text="Параметры приложения" />
                        <TextBlock Margin="0,18,0,0"
                                   Style="{StaticResource BodyTextStyle}"
                                   TextWrapping="Wrap"
                                   Text="Системные настройки и административные параметры будут вынесены сюда на следующем этапе." />
                    </StackPanel>
                </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
