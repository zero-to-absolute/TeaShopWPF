<Window x:Class="TeaShopManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sections="clr-namespace:TeaShopManager.Views.Sections"
        mc:Ignorable="d"
        Title="TeaShopManager"
        Width="1540"
        Height="940"
        MinWidth="1320"
        MinHeight="860"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16,18,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource BodyTextStyle}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="{Binding RoleTag}" />
                    <TextBlock Style="{StaticResource HeroHeadingTextStyle}"
                               Margin="0,16,0,0"
                               FontSize="30"
                               Text="TeaShopManager" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         Margin="0,28,0,22"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem}"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                </Grid.ColumnDefinitions>

                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{Binding IconGlyph}" />

                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Text="{Binding Title}" />

                                <Ellipse Grid.Column="2"
                                         Width="8"
                                         Height="8"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Fill="{StaticResource AttentionBrush}"
                                         Visibility="{Binding HasAttentionMark, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,0,12" />
                            <Setter Property="Padding" Value="14,16" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="12"
                                                BorderBrush="Transparent"
                                                BorderThickness="1">
                                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#EFE4D7" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <Border Grid.Row="2"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyTextStyle}"
                                   FontSize="12"
                                   Text="Вы вошли как" />

                        <StackPanel Margin="0,12,0,0">
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="{Binding CurrentUser.Login}" />
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource BodyTextStyle}"
                                       TextWrapping="Wrap"
                                       Text="{Binding CurrentUser.DisplayName}" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource BodyTextStyle}"
                                       TextWrapping="Wrap"
                                       Text="{Binding RoleCaption}" />
                        </StackPanel>

                        <Button Margin="0,18,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding SignOutCommand}"
                                Content="Выйти" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1"
              Margin="20,18,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="24,12">
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource SectionTitleTextStyle}"
                           Text="{Binding PageTitle}" />
            </Border>

            <ScrollViewer Grid.Row="1"
                          Margin="0,18,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid MinHeight="720">
                    <sections:AdministrationSectionView />
                    <sections:CatalogSectionView />
                    <sections:OrdersSectionView />
                    <sections:NotificationsSectionView />
                    <sections:InventorySectionView />
                    <sections:ReportsSectionView />
                    <sections:SalesSectionView />
                    <sections:SettingsSectionView />
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
