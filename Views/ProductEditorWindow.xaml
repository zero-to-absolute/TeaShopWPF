<Window x:Class="TeaShopManager.Views.ProductEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар"
        Width="660"
        Height="820"
        MinWidth="620"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        SizeToContent="WidthAndHeight">
    <Border Margin="18"
            Style="{StaticResource CardBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                       FontSize="26"
                       Text="{Binding WindowTitle}" />

            <ScrollViewer Grid.Row="1"
                          Margin="0,22,0,0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Название товара" />
                    <TextBox x:Name="ProductNameTextBox" Margin="0,10,0,0" Style="{StaticResource InputTextBoxStyle}" />

                    <TextBlock Margin="0,18,0,0" FontWeight="SemiBold" Text="Цена" />
                    <TextBox x:Name="PriceTextBox" Margin="0,10,0,0" Style="{StaticResource InputTextBoxStyle}" />

                    <TextBlock Margin="0,18,0,0" FontWeight="SemiBold" Text="Мин. остаток" />
                    <TextBox x:Name="MinStockTextBox" Margin="0,10,0,0" Style="{StaticResource InputTextBoxStyle}" />

                    <TextBlock Margin="0,18,0,0" FontWeight="SemiBold" Text="Срок годности (дней)" />
                    <TextBox x:Name="ExpirationTextBox" Margin="0,10,0,0" Style="{StaticResource InputTextBoxStyle}" />

                    <TextBlock Margin="0,18,0,0" FontWeight="SemiBold" Text="Категория" />
                    <ComboBox x:Name="CategoryComboBox"
                              Margin="0,10,0,0"
                              Height="52"
                              Padding="12,6"
                              ItemsSource="{Binding CategoryItems}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id" />

                    <TextBlock Margin="0,18,0,0" FontWeight="SemiBold" Text="Описание" />
                    <TextBox x:Name="DescriptionTextBox"
                             Margin="0,10,0,0"
                             MinHeight="110"
                             Padding="14"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2"
                  Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="Отмена"
                        Click="CancelButton_OnClick" />
                <Button Grid.Column="1"
                        Margin="10,0,0,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="Сохранить"
                        Click="SaveButton_OnClick" />
            </Grid>
        </Grid>
    </Border>
</Window>
